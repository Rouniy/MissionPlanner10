<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <StartupObject>MissionPlanner.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AppConfig>Porting/net10.app.config</AppConfig>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows')) Or
                                '$(RuntimeIdentifier)' == 'win-x64'">Assets/appicon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>MissionPlanner</AssemblyName>
    <RootNamespace>MissionPlanner</RootNamespace>

    <!-- The main application uses an explicit, audited compile graph. Ported WinForms sources are
         removed only after their NATIVE_SURFACE.tsv rows identify the Avalonia replacement. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>

    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <IsAvaloniaPortProject>true</IsAvaloniaPortProject>
    <IsMissionPlannerApplication>true</IsMissionPlannerApplication>

    <!-- Keep AssemblyName=MissionPlanner for legacy plugin ABI compatibility. -->
    <Product>Mission Planner 10</Product>
    <Company>Mission Planner contributors</Company>
    <Authors>Michael Oborne; Mission Planner contributors</Authors>
    <Description>Mission Planner 10 cross-platform ground control station for ArduPilot.</Description>
    <Copyright>Copyright © Mission Planner contributors. GPLv3.</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Rouniy/MissionPlanner</RepositoryUrl>

    <MissionPlannerVersionFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/Properties/AssemblyInfo.cs'))</MissionPlannerVersionFile>
    <MissionPlannerVersionFileExists>$([System.IO.File]::Exists('$(MissionPlannerVersionFile)'))</MissionPlannerVersionFileExists>
    <MissionPlannerLocalBuildFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/build/local-build-number.txt'))</MissionPlannerLocalBuildFile>
    <MissionPlannerLocalBuildFileExists>$([System.IO.File]::Exists('$(MissionPlannerLocalBuildFile)'))</MissionPlannerLocalBuildFileExists>
    <MissionPlannerUpstreamVersion Condition="'$(MissionPlannerUpstreamVersion)' == '' And '$(MissionPlannerVersionFileExists)' == 'True'">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MissionPlannerVersionFile)')), 'AssemblyFileVersion\(&quot;([0-9]+\.[0-9]+\.[0-9]+)&quot;\)').Groups[1].Value)</MissionPlannerUpstreamVersion>
    <MissionPlannerUpstreamVersion Condition="'$(MissionPlannerUpstreamVersion)' == ''">0.0.0</MissionPlannerUpstreamVersion>
    <MissionPlannerLocalBuildNumber Condition="'$(MissionPlannerLocalBuildNumber)' == '' And '$(MissionPlannerLocalBuildFileExists)' == 'True'">$([System.String]::Copy($([System.IO.File]::ReadAllText('$(MissionPlannerLocalBuildFile)'))).Trim())</MissionPlannerLocalBuildNumber>
    <MissionPlannerLocalBuildNumber Condition="'$(MissionPlannerLocalBuildNumber)' == ''">0</MissionPlannerLocalBuildNumber>
    <MissionPlannerLocalBuildNumberValid>$([System.Text.RegularExpressions.Regex]::IsMatch('$(MissionPlannerLocalBuildNumber)', '^[1-9][0-9]{0,4}$'))</MissionPlannerLocalBuildNumberValid>
    <MissionPlannerLocalBuildNumberValue Condition="'$(MissionPlannerLocalBuildNumberValid)' == 'True'">$([System.Int32]::Parse('$(MissionPlannerLocalBuildNumber)'))</MissionPlannerLocalBuildNumberValue>
    <Version>$(MissionPlannerUpstreamVersion).$(MissionPlannerLocalBuildNumber)</Version>
    <!-- Keep the assembly version on the upstream ABI identity; local builds vary FileVersion. -->
    <AssemblyVersion>$(MissionPlannerUpstreamVersion).0</AssemblyVersion>
    <FileVersion>$(MissionPlannerUpstreamVersion).$(MissionPlannerLocalBuildNumber)</FileVersion>
    <InformationalVersion>$(MissionPlannerUpstreamVersion).$(MissionPlannerLocalBuildNumber)</InformationalVersion>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PublishAot Condition="'$(EnableNativeAot)' == 'true'">true</PublishAot>
  </PropertyGroup>

  <Target Name="ValidateMissionPlannerVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(MissionPlannerVersionFileExists)' != 'True'"
           Text="Native Mission Planner Properties/AssemblyInfo.cs is missing." />
    <Error Condition="'$(MissionPlannerUpstreamVersion)' == '0.0.0'"
           Text="Could not read AssemblyFileVersion x.y.z from $(MissionPlannerVersionFile)." />
    <Error Condition="'$(MissionPlannerLocalBuildFileExists)' != 'True'"
           Text="Tracked local build number is missing: $(MissionPlannerLocalBuildFile)." />
    <Error Condition="'$(MissionPlannerLocalBuildNumberValid)' != 'True'"
           Text="Local build number must be a canonical positive integer: '$(MissionPlannerLocalBuildNumber)'." />
    <Error Condition="'$(MissionPlannerLocalBuildNumberValid)' == 'True' And
                      ($(MissionPlannerLocalBuildNumberValue) &lt; 1 Or
                       $(MissionPlannerLocalBuildNumberValue) &gt; 65535)"
           Text="Local build number must be from 1 through 65535: '$(MissionPlannerLocalBuildNumber)'." />
  </Target>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

