  <Target Name="FetchMacVlc"
          BeforeTargets="PrepareForBuild"
          Condition="'$(MacVlcRid)' != ''">
    <Error Condition="'$(MacVlcRid)' != 'osx-x64' And
                      '$(MacVlcRid)' != 'osx-arm64'"
           Text="Unsupported macOS VLC runtime identifier: $(MacVlcRid)" />
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/build/vlc/fetch-macos.sh&quot; &quot;$(MacVlcRid)&quot; &quot;$(MacVlcRuntimeDir)&quot;" />
  </Target>

  <!-- Preserve VLC's original lib/plugins/share layout in output and the final .app bundle. -->
  <Target Name="CollectMacVlcRuntime"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="FetchMacVlc"
          Condition="'$(MacVlcRid)' != ''">
    <ItemGroup>
      <_MacVlcLib Include="$(MacVlcRuntimeDir)/lib/**/*" />
      <_MacVlcPlugins Include="$(MacVlcRuntimeDir)/plugins/**/*" />
      <_MacVlcLua Include="$(MacVlcRuntimeDir)/share/lua/**/*" />
      <_MacVlcHrtfs Include="$(MacVlcRuntimeDir)/share/hrtfs/**/*" />

      <Content Include="@(_MacVlcLib)">
        <Link>lib/%(_MacVlcLib.RecursiveDir)%(_MacVlcLib.Filename)%(_MacVlcLib.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
      <Content Include="@(_MacVlcPlugins)">
        <Link>plugins/%(_MacVlcPlugins.RecursiveDir)%(_MacVlcPlugins.Filename)%(_MacVlcPlugins.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
      <Content Include="@(_MacVlcLua)">
        <Link>share/lua/%(_MacVlcLua.RecursiveDir)%(_MacVlcLua.Filename)%(_MacVlcLua.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
      <Content Include="@(_MacVlcHrtfs)">
        <Link>share/hrtfs/%(_MacVlcHrtfs.RecursiveDir)%(_MacVlcHrtfs.Filename)%(_MacVlcHrtfs.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>

  <Target Name="FetchMacSimpleBle"
          BeforeTargets="PrepareForBuild"
          Condition="'$(SimpleBleMacRid)' != ''">
    <Error Condition="'$(SimpleBleMacRid)' != 'osx-x64' And
                      '$(SimpleBleMacRid)' != 'osx-arm64'"
           Text="Unsupported macOS SimpleBLE runtime identifier: $(SimpleBleMacRid)" />
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/build/simpleble/fetch-macos.sh&quot; &quot;$(SimpleBleMacRid)&quot; &quot;$(SimpleBleMacNativeDir)&quot;" />
  </Target>

  <Target Name="BuildDflogNative"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DflogLibraryName)' != '' And '$(DesignTimeBuild)' != 'true'">
    <Exec Command="cargo --version"
          IgnoreExitCode="true"
          EchoOff="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="DflogCargoProbeExitCode" />
    </Exec>
    <Message Condition="'$(DflogCargoProbeExitCode)' != '0'"
             Importance="high"
             Text="dflog: cargo not found on PATH; skipping the native log parser build (the managed parser is used at runtime)" />

    <!-- A toolchain that cannot build for this target is treated like no
         toolchain at all: skip, do not fail the build. Cross-building osx-x64
         on an Apple Silicon host is the common case. -->
    <Exec Condition="'$(DflogCargoProbeExitCode)' == '0' And '$(DflogRustTriple)' != ''"
          Command="rustup target list --installed"
          IgnoreExitCode="true"
          EchoOff="true"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          WorkingDirectory="$(MSBuildProjectDirectory)/rust">
      <Output TaskParameter="ExitCode" PropertyName="DflogRustupProbeExitCode" />
      <Output TaskParameter="ConsoleOutput" PropertyName="DflogInstalledTargets" />
    </Exec>
    <PropertyGroup Condition="'$(DflogRustupProbeExitCode)' == '0' And '$(DflogInstalledTargets)' != ''">
      <!-- Substring rather than exact match, deliberately: an unreadable or
           unexpected list must leave the build attempted (cargo then fails
           loudly), never silently skipped. -->
      <DflogTargetInstalled>$(DflogInstalledTargets.Contains('$(DflogRustTriple)'))</DflogTargetInstalled>
      <DflogTargetMissing Condition="'$(DflogTargetInstalled)' == 'false'">true</DflogTargetMissing>
    </PropertyGroup>
    <Message Condition="'$(DflogTargetMissing)' == 'true'"
             Importance="high"
             Text="dflog: the Rust target $(DflogRustTriple) is not installed (add it with 'rustup target add $(DflogRustTriple)'); skipping the native log parser build (the managed parser is used at runtime)" />

    <Exec Condition="'$(DflogCargoProbeExitCode)' == '0' And '$(DflogTargetMissing)' != 'true'"
          Command="cargo build --release --package dflog-ffi --target-dir &quot;$(DflogNativeDir)&quot;$(DflogCargoTargetArg)"
          WorkingDirectory="$(MSBuildProjectDirectory)/rust" />
  </Target>

  <Target Name="IncludeDflogNativeContent"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="BuildDflogNative"
          Condition="'$(DflogLibraryName)' != ''">
    <ItemGroup Condition="Exists('$(DflogReleaseDir)/$(DflogLibraryName)')">
      <Content Include="$(DflogReleaseDir)/$(DflogLibraryName)" Link="$(DflogLibraryName)">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>

  <Target Name="RemoveWindowsNativeBinariesFromNonWindowsPublish"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or
                     '$(RuntimeIdentifier)' == 'osx-x64' Or
                     '$(RuntimeIdentifier)' == 'osx-arm64' Or
                     ('$(RuntimeIdentifier)' == '' And
                      !$([MSBuild]::IsOSPlatform('Windows')))">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'libusb-1.0.dll' Or
                                        '%(Filename)%(Extension)' == 'simpleble-c.dll' Or
                                        '%(Filename)%(Extension)' == 'simpleble.dll'" />
    </ItemGroup>
  </Target>
</Project>
