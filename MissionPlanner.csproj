    <Compile Include="Services/SikRadioFirmwareService.cs" />
    <Compile Include="Services/SikRadioSettingsService.cs" />
    <Compile Include="Services/SizeLimitedReadStream.cs" />
    <Compile Include="Services/SystemAwakeService.cs" />
    <Compile Include="Services/StartupUdpListenerService.cs" />
