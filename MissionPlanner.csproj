    <Compile Include="ViewModels/ExternalGuidedViewModel.cs" />
    <Compile Include="Views/DroneCanFieldGraphWindow.cs" />
    <Compile Include="Views/DroneCanSubscriberWindow.cs" />
    <Compile Include="Views/ExternalGuidedView.axaml.cs" />
    <Compile Include="Views/ExternalGuidedWindow.cs" />
